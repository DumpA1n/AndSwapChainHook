@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@ANDSWAPCHAIN_BUILD_POINTER_ADAPTER@)
    find_dependency(PointerHook CONFIG)
endif()
if(@ANDSWAPCHAIN_BUILD_GRAPHICS@ AND NOT TARGET Dobby::Dobby)
    find_dependency(Dobby 1 CONFIG)
endif()
if(@ANDSWAPCHAIN_BUILD_ASSEMBLER@ AND NOT TARGET Keystone::Keystone)
    find_dependency(Keystone 0.9.2 CONFIG)
endif()
if(@ANDSWAPCHAIN_BUILD_DISASSEMBLER@ AND NOT TARGET Capstone::Capstone)
    find_dependency(Capstone 6 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/AndSwapChainHookTargets.cmake")
foreach(component Memory Analysis Instrumentation Graphics Overlay HookAdapter CrashRecorder Input Profiler Assembler Disassembler Assemble)
    if(TARGET AndSwapChainHook::${component})
        set(AndSwapChainHook_${component}_FOUND TRUE)
    else()
        set(AndSwapChainHook_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(AndSwapChainHook)
