{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ANDSWAPCHAIN_BUILD_ANDROID": "OFF"
      }
    },
    {
      "name": "host-release",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host-sanitized",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build/host-sanitized",
      "cacheVariables": {
        "ANDSWAPCHAIN_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "android-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-debug",
      "toolchainFile": "$env{NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-27",
        "ANDSWAPCHAIN_BUILD_ANDROID": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "android-release",
      "inherits": "android-debug",
      "binaryDir": "${sourceDir}/build/android-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-graphics",
      "inherits": "android-debug",
      "binaryDir": "${sourceDir}/build/android-graphics",
      "cacheVariables": {
        "ANDSWAPCHAIN_BUILD_GRAPHICS": "ON"
      }
    },
    {
      "name": "android-modules-debug",
      "inherits": "android-debug",
      "binaryDir": "${sourceDir}/build/android-modules-debug",
      "cacheVariables": {
        "ANDSWAPCHAIN_BUILD_GRAPHICS": "ON",
        "ANDSWAPCHAIN_BUILD_OVERLAY": "ON",
        "ANDSWAPCHAIN_BUILD_CRASH_RECORDER": "ON"
      }
    },
    {
      "name": "android-modules-release",
      "inherits": "android-modules-debug",
      "binaryDir": "${sourceDir}/build/android-modules-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host-optional",
      "inherits": "host-sanitized",
      "binaryDir": "${sourceDir}/build/host-optional",
      "cacheVariables": {
        "ANDSWAPCHAIN_BUILD_CRASH_RECORDER": "ON"
      }
    },
    {
      "name": "host-assemble-debug",
      "inherits": "host-sanitized",
      "binaryDir": "${sourceDir}/build/host-assemble-debug",
      "cacheVariables": {
        "ANDSWAPCHAIN_BUILD_ASSEMBLE": "ON"
      }
    },
    {
      "name": "host-assemble-release",
      "inherits": "host-release",
      "binaryDir": "${sourceDir}/build/host-assemble-release",
      "cacheVariables": {
        "ANDSWAPCHAIN_BUILD_ASSEMBLE": "ON"
      }
    },
    {
      "name": "android-assemble-debug",
      "inherits": "android-debug",
      "binaryDir": "${sourceDir}/build/android-assemble-debug",
      "cacheVariables": {
        "ANDSWAPCHAIN_BUILD_ASSEMBLE": "ON"
      }
    },
    {
      "name": "android-assemble-release",
      "inherits": "android-release",
      "binaryDir": "${sourceDir}/build/android-assemble-release",
      "cacheVariables": {
        "ANDSWAPCHAIN_BUILD_ASSEMBLE": "ON"
      }
    },
    {
      "name": "host-disassembler",
      "inherits": "host-release",
      "binaryDir": "${sourceDir}/build/host-disassembler",
      "cacheVariables": {
        "ANDSWAPCHAIN_BUILD_DISASSEMBLER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "host-sanitized",
      "configurePreset": "host-sanitized"
    },
    {
      "name": "android-debug",
      "configurePreset": "android-debug"
    },
    {
      "name": "android-release",
      "configurePreset": "android-release"
    },
    {
      "name": "android-graphics",
      "configurePreset": "android-graphics"
    },
    {
      "name": "android-modules-debug",
      "configurePreset": "android-modules-debug"
    },
    {
      "name": "android-modules-release",
      "configurePreset": "android-modules-release"
    },
    {
      "name": "host-optional",
      "configurePreset": "host-optional"
    },
    {
      "name": "host-assemble-debug",
      "configurePreset": "host-assemble-debug"
    },
    {
      "name": "host-assemble-release",
      "configurePreset": "host-assemble-release"
    },
    {
      "name": "android-assemble-debug",
      "configurePreset": "android-assemble-debug"
    },
    {
      "name": "android-assemble-release",
      "configurePreset": "android-assemble-release"
    },
    {
      "name": "host-disassembler",
      "configurePreset": "host-disassembler"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-sanitized",
      "configurePreset": "host-sanitized",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-optional",
      "configurePreset": "host-optional",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-assemble-debug",
      "configurePreset": "host-assemble-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-assemble-release",
      "configurePreset": "host-assemble-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-disassembler",
      "configurePreset": "host-disassembler",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
